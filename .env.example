# Mapillary client token: https://www.mapillary.com/dashboard/developers
# Only this one is used by extract.py. Keep the quotes, `|` breaks shell `source`.
MAPILLARY_ACCESS_TOKEN="MLY|your_client_id|your_client_token"

# Not used by extract.py (OAuth flow only)
MAPILLARY_CLIENT_SECRET=""
MAPILLARY_AUTHENTICATION_URL=""