# Mapillary client token: https://www.mapillary.com/dashboard/developers
# Only this one is used by extract.py. Keep the quotes, `|` breaks shell `source`.
MAPILLARY_ACCESS_TOKEN="MLY|your_client_id|your_client_token"

# --- Supabase (Auth only) ---
SUPABASE_URL=https://<project-ref>.supabase.co

# --- Server (FastAPI on skyloft) ---
DATABASE_URL=postgresql://aveiro:CHANGE_ME@127.0.0.1:5432/aveiro
IMAGE_DIR=/var/lib/aveiro-urban/images
PUBLIC_IMAGE_BASE_URL=https://api.example.com/img
CORS_ORIGINS=https://app.example.com,http://localhost:5173

# --- Models ---
DETECT_MODEL_PATH=/var/lib/aveiro-urban/models/detect.onnx
DETECT_CLASSES_PATH=/var/lib/aveiro-urban/models/classes.json
BLUR_FACE_MODEL_PATH=/var/lib/aveiro-urban/models/face.onnx
BLUR_PLATE_MODEL_PATH=/var/lib/aveiro-urban/models/plate.onnx