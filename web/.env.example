VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key from the Supabase Connect panel.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Your FastAPI backend. Leave as /api when using the Vite proxy or the local server.
VITE_API_BASE_URL=/api

# CARTO basemap key for the Leaflet map (light + dark tiles).
# Create one at https://carto.com/ (free tier). This key is public by design:
# it is shipped in the browser bundle and only grants basemap tile reads.
VITE_CARTO_API_KEY=
